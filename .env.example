LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Local Ollama embedding (OpenAI-compatible). Leave blank to fall back to BM25.
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=8

# Or remote (SiliconFlow / DashScope), for example:
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

CHROMA_DIR=data/chroma
RAW_DIR=data/raw
EXPORT_DIR=data/exports
MEMORY_DB=data/memory.db
COLLECTION_NAME=enterprise_docs

# Kaoyan (硕士研招) structured store and seed bundle
KAOYAN_DB=data/kaoyan.db
KAOYAN_DATA_DIR=data/kaoyan
# Kaoyan RAG index (scripts/ingest_kaoyan.py); rag_search uses it when school/year/doc_type is given
KAOYAN_CHROMA_DIR=data/chroma_kaoyan
KAOYAN_COLLECTION=kaoyan_docs
# Default index for rag_search / list_documents: enterprise or kaoyan
RAG_PROFILE=enterprise
# OCR for images / scanned PDF pages: none (flag needs_ocr only)
OCR_BACKEND=none

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
MAX_TOOL_CALLS=5
REQUEST_TIMEOUT=120
